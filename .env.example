# Example configuration. Copy to `.env` and edit, or set these in the shell.
# Nothing here is read automatically -- Razor reads process env only.

# ---------------------------------------------------------------------------
# Security mode. This is the switch that decides everything.
# `production` cannot be downgraded by the end user: bypass flags are refused
# and logged. Unset defaults to `dev` with a loud warning.
# ---------------------------------------------------------------------------
RAZOR_ENV=dev

# ---------------------------------------------------------------------------
# Admin credentials. REQUIRED in production; no default is generated there.
# ---------------------------------------------------------------------------
# RAZOR_ADMIN_USER=admin
# RAZOR_ADMIN_PASS=replace-me
# RAZOR_ADMIN_TOKEN=

# ---------------------------------------------------------------------------
# Listening. Defaults to loopback on an ephemeral port.
# ---------------------------------------------------------------------------
# RAZOR_HOST=127.0.0.1
# RAZOR_PORT=0

# ---------------------------------------------------------------------------
# The only directory the editor and the terminal operate in.
# ---------------------------------------------------------------------------
# RAZOR_WORKSPACE=C:\RazorExam

# ---------------------------------------------------------------------------
# Safe Exam Browser
# ---------------------------------------------------------------------------
# RAZOR_SEB_EXE=C:\Program Files\SafeExamBrowser\Application\SafeExamBrowser.exe
# Encrypted (Config Tool) config. REQUIRED in production unless
# RAZOR_ALLOW_UNENCRYPTED_SEB=1 is set explicitly.
# RAZOR_SEB_CONFIG=C:\Exam\exam.seb
# RAZOR_SEB_CONFIG_KEY_HASH=
# 1 = windowed + allowQuit. Use for the first run so you cannot be trapped.
# RAZOR_SEB_WINDOWED=0
# Extra URL-filter allow entries, comma separated.
# RAZOR_SEB_ALLOW_ORIGINS=
# 1 = allow the generated unencrypted config in production (logged, not advised).
# RAZOR_ALLOW_UNENCRYPTED_SEB=0
# Restrict accepted SEB client versions, e.g. Win.3.10.min
# RAZOR_SEB_ALLOWED_VERSIONS=

# Per-session quit passwords are returned by the admin start call. This is only
# a dev-bypass fallback.
# RAZOR_QUIT_PASSWORD=

# ---------------------------------------------------------------------------
# Session lease. Fail closed: lock after grace once heartbeats stop.
# ---------------------------------------------------------------------------
# RAZOR_LEASE_MS=60000
# RAZOR_GRACE_MS=60000

# ---------------------------------------------------------------------------
# Outbound control plane (no inbound port needed). Optional.
# ---------------------------------------------------------------------------
# RAZOR_CONTROL_PLANE_URL=http://127.0.0.1:8443
# RAZOR_DEVICE_ID=
# RAZOR_DEVICE_TOKEN=
# RAZOR_HEARTBEAT_MS=7000
# RAZOR_HEARTBEAT_TIMEOUT_MS=5000

# HMAC key that signs grants. Set this from a secret store in production so an
# out-of-process issuer can sign and a candidate cannot forge one.
# RAZOR_GRANT_KEY=

# ---------------------------------------------------------------------------
# Terminal confinement. `jobobject` is the production default and currently
# FAILS LOUDLY rather than pretending to confine (see docs/security.md).
# ---------------------------------------------------------------------------
# RAZOR_CONFINEMENT=none

# ---------------------------------------------------------------------------
# Diagnostics
# ---------------------------------------------------------------------------
# RAZOR_LOG_LEVEL=info
# RAZOR_LOG_FILE=
# RAZOR_AUDIT_STDERR=0
# RAZOR_UI_SOURCEMAP=0
