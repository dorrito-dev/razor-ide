{
  "name": "razor-ide",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Razor - a local, browser-based IDE (CodeMirror 6 editor + xterm.js PTY terminal) with a Safe Exam Browser lockdown launcher.",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "postinstall": "node scripts/verify-pty.mjs",
    "build": "node scripts/build.mjs",
    "dev": "node src/main.mjs --ui dev",
    "dev:seb": "node src/main.mjs --ui dev --seb",
    "start": "node src/main.mjs",
    "start:seb": "node src/main.mjs --seb",
    "admin": "node tools/admin-cli.mjs",
    "fake-admin": "node tools/fake-admin.mjs",
    "test": "node --test \"test/**/*.test.mjs\""
  },
  "dependencies": {
    "node-pty": "1.1.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.9",
    "@codemirror/lang-javascript": "^6.2.2",
    "@codemirror/lang-json": "^6.0.1",
    "@codemirror/lang-markdown": "^6.3.1",
    "@codemirror/lang-python": "^6.1.6",
    "@codemirror/lang-rust": "^6.0.1",
    "@codemirror/state": "^6.5.0",
    "@codemirror/theme-one-dark": "^6.1.2",
    "@codemirror/view": "^6.35.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "codemirror": "^6.0.1",
    "esbuild": "^0.24.0"
  }
}
